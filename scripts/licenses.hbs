<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title>editor dependency licenses</title>
<style>body{max-width:70rem;margin:2rem auto;padding:0 1rem;font-family:system-ui}pre{white-space:pre-wrap;overflow-wrap:anywhere}</style>
</head><body>
<h1>editor dependency licenses</h1>
<p>Generated from the locked dependency graph for all release platforms.
Theme licenses are in themes/. Additional asset notices are in licenses/.</p>
{{#each licenses}}
<section><h2>{{name}}</h2><ul>
{{#each used_by}}<li>{{crate.name}} {{crate.version}}</li>{{/each}}
</ul><pre>{{text}}</pre></section>
{{/each}}
</body></html>
